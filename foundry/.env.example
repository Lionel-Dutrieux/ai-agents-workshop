# Endpoint du projet Foundry — écran d'accueil du projet dans le portail.
# Format : https://<ressource>.services.ai.azure.com/api/projects/<projet>
PROJECT_ENDPOINT=""

# Nom de l'agent créé dans le portail (voir agent-instructions.md).
AGENT_NAME="brewly-review-analyst"

# --- Alternative sans `az login` (service principal) ---------------------
# Le Foundry Agent Service n'accepte PAS de clé API (Entra ID obligatoire).
# Mais DefaultAzureCredential lit automatiquement ces 3 variables si elles
# sont renseignées : app registration + rôle "Foundry User" sur le projet.
# AZURE_TENANT_ID=""
# AZURE_CLIENT_ID=""
# AZURE_CLIENT_SECRET=""
