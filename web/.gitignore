# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env : .env est versionné (aucun secret — voir le commentaire dans le fichier) ;
# seules les variantes locales restent ignorées.
.env*.local

# sqlite — dev.db EST versionnée (base prête à l'emploi, données seedées),
# seuls les fichiers de journal restent ignorés.
prisma/*.db-journal
prisma/*.db-shm
prisma/*.db-wal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma
