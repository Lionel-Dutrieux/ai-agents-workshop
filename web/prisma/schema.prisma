// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Une conversation de chat persistée localement, scopée par exercice.
model Conversation {
  /// UUID généré côté client au premier message.
  id        String    @id
  /// Exercice d'origine (ex. "01-chat"), dérivé de l'endpoint API.
  exercise  String
  /// Titre lisible, dérivé du premier message utilisateur.
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  messages  Message[]

  @@index([exercise, updatedAt])
}

/// Un modèle LLM ajouté dynamiquement, exposé via un endpoint
/// OpenAI-compatible (Ollama, Azure AI Foundry, etc.).
model Model {
  id       String @id @default(cuid())
  /// Nom affiché dans le sélecteur.
  label    String
  /// Type de fournisseur, pour l'affichage/les préréglages : "ollama" | "azure" | "custom".
  provider String
  /// URL de base de l'endpoint OpenAI-compatible (ex. "http://localhost:11434/v1").
  baseUrl  String
  /// Identifiant du modèle côté fournisseur (ex. "llama3.1", "gpt-4o").
  modelId  String
  /// Clé API — SECRET, jamais renvoyée au client. Nulle pour Ollama.
  apiKey   String?
  /// Taille de la fenêtre de contexte, pour la jauge de tokens.
  contextWindow Int?
  /// Proposé dans le sélecteur ?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([enabled, createdAt])
}

/// Exemple / template de données pour la sandbox CRUD des tutoriels.
/// Modèle neutre à copier pour créer les vraies données d'un exercice.
model SandboxItem {
  id        String   @id @default(cuid())
  name      String
  category  String
  price     Int      @default(0)
  inStock   Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([createdAt])
}

/// Catalogue produits de Brewly — la « vraie » base lue par les outils du
/// module 03 (Tool calling). Éditable depuis la sandbox CRUD du tutoriel :
/// modifier une ligne ici change ce que l'agent répond. Amorcé au 1er accès.
model BrewlyProduct {
  id          String   @id @default(cuid())
  /// Référence catalogue lisible (ex. "CAF-ETH"), unique.
  reference   String   @unique
  nom         String
  /// "cafe" | "machine" | "accessoire".
  categorie   String
  /// Prix en euros (décimal → REAL SQLite).
  prix        Float    @default(0)
  /// Origine géographique (cafés), null pour machines/accessoires.
  origine     String?
  /// Intensité 1–10 (cafés), null sinon.
  intensite   Int?
  description  String  @default("")
  enStock     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([categorie])
  @@index([createdAt])
}

/// Une commande client de Brewly — données de démo lues par les outils de
/// l'agent (module 03/04). Éditable depuis la sandbox. `articles` est un
/// tableau JSON sérialisé (SQLite n'a pas de type liste).
model BrewlyOrder {
  id               String   @id @default(cuid())
  /// Numéro de commande lisible (ex. "1042"), unique.
  numero           String   @unique
  /// "en_preparation" | "expediee" | "livree" | "annulee".
  statut           String
  /// Libellés des articles, sérialisés en JSON (ex. ["Moulin", "Colombie"]).
  articles         String   @default("[]")
  /// Total en euros.
  total            Float    @default(0)
  /// Date de commande au format ISO court (yyyy-mm-dd), comme le DTO.
  commandeeLe      String
  /// Date de livraison estimée (ISO court), null si inconnue.
  livraisonEstimee String?
  transporteur     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  @@index([statut])
  @@index([createdAt])
}

/// Un serveur MCP ajouté dynamiquement (transport HTTP).
model McpServer {
  id   String @id @default(cuid())
  name String
  url  String
  /// En-têtes HTTP personnalisés (ex. Authorization), sérialisés en JSON.
  /// SECRET : jamais renvoyés au client, uniquement lus côté serveur.
  headers   String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([enabled, createdAt])
}

/// Un message au format UIMessage du AI SDK, sérialisé pour SQLite.
model Message {
  id             Int          @id @default(autoincrement())
  /// Identifiant du UIMessage (stable côté client), utilisé comme clé React.
  uiId           String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  /// `UIMessage.parts` sérialisé en JSON (SQLite n'a pas de type JSON natif).
  parts          String
  /// `UIMessage.metadata` sérialisé en JSON (usage, modelId…).
  metadata       String?
  /// Position dans la conversation, pour restaurer l'ordre.
  position       Int
  createdAt      DateTime     @default(now())

  @@index([conversationId, position])
}
