# Base de données (SQLite locale, versionnée avec le projet)
DATABASE_URL="file:./prisma/dev.db"

# Les modèles LLM (LM Studio, Ollama, Azure AI Foundry…) se configurent DANS
# l'application (sélecteur de modèle → « Gérer les modèles ») — aucune clé
# n'est nécessaire ici. Voir exercices/00-prerequis.md.
# ⚠️ Ne mettez JAMAIS de vraie clé API dans ce fichier : il est versionné.

# Module 08 — RAG : modèle d'embeddings servi par LM Studio (valeurs par défaut).
# Les vecteurs de l'index et des questions doivent venir du MÊME modèle.
# EMBEDDINGS_BASE_URL="http://localhost:1234/v1"
# EMBEDDINGS_MODEL_ID="text-embedding-nomic-embed-text-v1.5"
# Clé API optionnelle : uniquement si l'authentification est activée dans
# LM Studio (Developer → Settings). Ce fichier étant versionné, mettez une
# vraie clé plutôt dans .env.local (non versionné).
# EMBEDDINGS_API_KEY=""
