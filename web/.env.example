# Base de données (SQLite locale, créée par `npx prisma migrate dev`)
DATABASE_URL="file:./dev.db"

# Provider LLM — décommenter selon le provider retenu pour le workshop
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# AZURE_OPENAI_API_KEY=""

# Module 08 — RAG : modèle d'embeddings servi par LM Studio (valeurs par défaut).
